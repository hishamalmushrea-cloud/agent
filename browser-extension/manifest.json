{
  "manifest_version": 3,
  "name": "Arena Windows Agent Bridge",
  "version": "2.0.0",
  "description": "Connects Arena (the brain) to the local Windows Agent (the hands) via a secure local bridge.",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "clipboardRead"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*", "http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Arena Windows Agent Bridge"
  },
  "content_scripts": [
    {
      "matches": ["https://arena.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
